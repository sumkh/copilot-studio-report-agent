<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>Monthly sales by region and product category</Description>
  <Author>Finance Reporting</Author>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="SalesDW">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=sql-prod-01.contoso.local;Initial Catalog=SalesDW</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>4ddda41c-80af-4f6e-ac0c-3a89ccfa3cc0</rd:DataSourceID>
    </DataSource>
    <DataSource Name="FinanceShared">
      <DataSourceReference>/Data Sources/FinanceDW</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>6a502f13-c211-4754-848c-4abbfb79e0ee</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsSales">
      <Query>
        <DataSourceName>SalesDW</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate"><Value>=Parameters!StartDate.Value</Value></QueryParameter>
          <QueryParameter Name="@EndDate"><Value>=Parameters!EndDate.Value</Value></QueryParameter>
          <QueryParameter Name="@Region"><Value>=Parameters!Region.Value</Value></QueryParameter>
        </QueryParameters>
        <CommandText>SELECT r.RegionName AS Region, p.Category AS ProductCategory,
       SUM(f.Units) AS Units, SUM(f.SalesAmount) AS SalesAmount, SUM(f.Cost) AS Cost
FROM dbo.FactSales f
JOIN dbo.DimRegion r ON r.RegionKey = f.RegionKey
JOIN dbo.DimProduct p ON p.ProductKey = f.ProductKey
JOIN dbo.DimDate d ON d.DateKey = f.DateKey
WHERE d.[Date] BETWEEN @StartDate AND @EndDate
  AND r.RegionName IN (@Region)
GROUP BY r.RegionName, p.Category</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Region"><DataField>Region</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ProductCategory"><DataField>ProductCategory</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Units"><DataField>Units</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="SalesAmount"><DataField>SalesAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="Cost"><DataField>Cost</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="MarginPct"><Value>=IIf(Fields!SalesAmount.Value = 0, 0, (Fields!SalesAmount.Value - Fields!Cost.Value) / Fields!SalesAmount.Value)</Value></Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsRegions">
      <Query>
        <DataSourceName>SalesDW</DataSourceName>
        <CommandText>SELECT DISTINCT RegionName FROM dbo.DimRegion ORDER BY RegionName</CommandText>
      </Query>
      <Fields>
        <Field Name="RegionName"><DataField>RegionName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems><Tablix Name="tblSales"><TablixBody><TablixColumns><TablixColumn><Width>1.6in</Width></TablixColumn><TablixColumn><Width>0.9in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>0.9in</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.25in</Height><TablixCells><TablixCell><CellContents><Textbox Name="hdr_ProductCategory"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Product Category</Value><Style><FontFamily>Calibri</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>hdr_ProductCategory</rd:DefaultName><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E78</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="hdr_Units"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Units</Value><Style><FontFamily>Calibri</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>hdr_Units</rd:DefaultName><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E78</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="hdr_SalesAmount"><CanGrow>true</CanGrow><KeepTogether>true</
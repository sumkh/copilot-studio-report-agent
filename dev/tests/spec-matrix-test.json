  "datasets": [
    {
      "name": "dsSales",
      "data_source": "SalesDW",
      "query_language": "SQL",
      "command_text": "SELECT r.RegionName AS Region, p.Category, d.MonthName, d.MonthNumber, SUM(f.SalesAmount) AS SalesAmount, SUM(f.Units) AS Units\nFROM dbo.FactSales f JOIN dbo.DimRegion r ON r.RegionKey = f.RegionKey JOIN dbo.DimProduct p ON p.ProductKey = f.ProductKey JOIN dbo.DimDate d ON d.DateKey = f.DateKey\nWHERE d.CalendarYear = @Year AND r.RegionName IN (@Region)\nGROUP BY r.RegionName, p.Category, d.MonthName, d.MonthNumber",
      "query_parameters": [
        {
          "name": "Year",
          "value": "=Parameters!Year.Value"
        },
        {
          "name": "@Region",
          "value": "=Parameters!Region.Value"
        }
      ],
      "fields": [
        {
          "name": "Region",
          "data_field": "Region",
          "type": "String"
        },
        {
          "name": "Category",
          "data_field": "Category",
          "type": "String"
        },
        {
          "name": "MonthName",
          "data_field": "MonthName",
          "type": "String"
        },
        {
          "name": "MonthNumber",
          "data_field": "MonthNumber",
          "type": "Integer"
        },
        {
          "name": "SalesAmount",
          "data_field": "SalesAmount",
          "type": "Decimal"
        },
        {
          "name": "Units",
          "data_field": "Units",
          "type": "Integer"
        }
      ],
      "verified": {
        "executed": true,
        "rows": 36,
        "at": "2026-10-26T10:00:00Z",
        "notes": "test run with Year=2026"
      }
    },
    {
      "name": "dsRegions",
      "data_source": "SalesDW",
      "query_language": "SQL",
      "command_text": "SELECT DISTINCT RegionName FROM dbo.DimRegion ORDER BY RegionName",
      "query_parameters": [],
      "fields": [
        {
          "name": "RegionName",
          "data_field": "RegionName",
          "type": "String"
        }
      ],
      "verified": {
        "executed": true,
        "rows": 36,
        "at": "2026-10-26T10:00:00Z",
        "notes": "test run with Year=2026"
      }
    }
  ],
  "parameters": [
    {
      "name": "Year",
      "data_type": "Integer",
      "prompt": "Year",
      "default": "=Year(Today())"
    },
    {
      "name": "Region",

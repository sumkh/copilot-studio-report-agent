# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Build output (recreate with: python dev/package_skill.py)
dist/

# Organisation settings: real values belong in the ENTERPRISE repo only.
# In the enterprise repo you can delete the next line to commit the file (see HANDOVER.md).
org/org-settings.json


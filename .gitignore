**/.mcs/

# Local copies of Microsoft schemas used for extra validation (not redistributed)
dev/schemas/

# Scratch output from trying the scripts locally, and Power BI Desktop's per-user project files
work/
**/.pbi/localSettings.json
**/.pbi/cache.abf

# Editors and OS
.DS_Store
Thumbs.db
*.swp
